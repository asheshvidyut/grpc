From 7526892afb602b9d9b3ef31d99444d4ce0e72764 Mon Sep 17 00:00:00 2001
From: Ashesh Vidyut <asheshvidyut@google.com>
Date: Wed, 8 Jul 2026 06:23:01 +0100
Subject: [PATCH 12/12] Mark aio wait_for_ready_test flaky

test_call_wait_for_ready_enabled rarely hangs in its server
stop/restart cycle. It reproduces over a Unix domain socket with no
TCP port involved, so it is a channel-state race rather than an
environmental problem; the sibling test_channel_ready_blocked is
already skipped for the same family of flakes
(https://github.com/grpc/grpc/issues/37949).
---
 src/python/grpcio_tests/tests_aio/unit/BUILD.bazel | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/python/grpcio_tests/tests_aio/unit/BUILD.bazel b/src/python/grpcio_tests/tests_aio/unit/BUILD.bazel
index d42cc25..5769115 100644
--- a/src/python/grpcio_tests/tests_aio/unit/BUILD.bazel
+++ b/src/python/grpcio_tests/tests_aio/unit/BUILD.bazel
@@ -58,6 +58,12 @@ py_library(
 _FLAKY_TESTS = [
     # TODO(https://github.com/grpc/grpc/issues/22347) remove from this list.
     "channel_argument_test.py",
+    # test_call_wait_for_ready_enabled rarely hangs in the server
+    # stop/restart cycle even over a Unix domain socket, pointing at a
+    # channel-state race rather than an environmental issue; the sibling
+    # test_channel_ready_blocked is already skipped for the same family of
+    # flakes (https://github.com/grpc/grpc/issues/37949).
+    "wait_for_ready_test.py",
 ]
 
 # All tests with runtime type checking
