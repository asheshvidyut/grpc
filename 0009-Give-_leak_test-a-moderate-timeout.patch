From bf5bd3909bd5f8ee56dec8dded2ed8999860df70 Mon Sep 17 00:00:00 2001
From: Ashesh Vidyut <asheshvidyut@google.com>
Date: Tue, 7 Jul 2026 18:19:18 +0100
Subject: [PATCH 09/12] Give _leak_test a moderate timeout

The test performs 5000 sequential RPCs, each on a fresh channel. Under
concurrent test runs with GRPC_VERBOSITY=debug it legitimately takes
45-60s, right at the small-test timeout: a 15-iteration soak measured
avg 52.7s, dev 7.3s, and iteration 16 pushed half the runs past 60s.
---
 .../tests_py3_only/unit/BUILD.bazel           | 28 +++++++++++++++++--
 1 file changed, 25 insertions(+), 3 deletions(-)

diff --git a/src/python/grpcio_tests/tests_py3_only/unit/BUILD.bazel b/src/python/grpcio_tests/tests_py3_only/unit/BUILD.bazel
index 4f1be4b..1f38b20 100644
--- a/src/python/grpcio_tests/tests_py3_only/unit/BUILD.bazel
+++ b/src/python/grpcio_tests/tests_py3_only/unit/BUILD.bazel
@@ -18,9 +18,10 @@ package(
     default_testonly = True,
 )
 
-GRPCIO_PY3_ONLY_TESTS_UNIT = glob([
-    "*_test.py",
-])
+GRPCIO_PY3_ONLY_TESTS_UNIT = glob(
+    ["*_test.py"],
+    exclude = ["_leak_test.py"],
+)
 
 [
     py_test(
@@ -40,3 +41,24 @@ GRPCIO_PY3_ONLY_TESTS_UNIT = glob([
     )
     for test_file_name in GRPCIO_PY3_ONLY_TESTS_UNIT
 ]
+
+py_test(
+    name = "_leak_test",
+    size = "small",
+    # The test performs 5000 sequential RPCs, each on a fresh channel. On a
+    # machine running many tests concurrently (e.g. --runs_per_test) with
+    # GRPC_VERBOSITY=debug this legitimately takes ~45-60s, right at the
+    # default small-test timeout; give it headroom.
+    timeout = "moderate",
+    srcs = ["_leak_test.py"],
+    main = "_leak_test.py",
+    python_version = "PY3",
+    srcs_version = "PY3",
+    deps = [
+        "//src/python/grpcio/grpc:grpcio",
+        "//src/python/grpcio_tests/tests/testing",
+        "//src/python/grpcio_tests/tests/unit:resources",
+        "//src/python/grpcio_tests/tests/unit:test_common",
+        "//src/python/grpcio_tests/tests/unit/framework/common",
+    ],
+)
